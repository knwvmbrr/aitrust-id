{
  "name": "ai-trust-id-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/prepare.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "deploy": "wrangler pages deploy dist --project-name aitrust-id --branch main --commit-dirty=true",
    "verify:data": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-tabs": "1.1.22",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
