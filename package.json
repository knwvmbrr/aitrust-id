{
  "name": "aitrust-id-verification",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "verify:browser": "node scripts/verify-browser.cjs",
    "build:site": "npm run build --prefix site",
    "dev:site": "npm run dev --prefix site",
    "verify:site": "node scripts/verify-site.cjs",
    "deploy:site": "npm run deploy --prefix site",
    "verify:device": "node scripts/verify-device.cjs",
    "verify:workflows": "node scripts/verify-workflows.cjs",
    "verify:policies": "node scripts/verify-policies.cjs",
    "verify:scope": "python3 scripts/verify-scope-plan.py",
    "verify:performance": "node scripts/verify-performance.cjs",
    "verify:enterprise": "node scripts/verify-enterprise.cjs",
    "verify:approachability": "node scripts/verify-approachability.cjs",
    "verify:ps-results": "node scripts/verify-ps-results.cjs",
    "verify:changelog": "node scripts/verify-changelog.cjs",
    "changelog": "python3 scripts/changelog-add.py",
    "test:changelog": "python3 -m unittest discover -s tests -p test_changelog_pipeline.py -v",
    "verify:bundle": "python3 scripts/verify-device-build-matrix.py",
    "verify:site-a11y": "node scripts/verify-site-accessibility.cjs",
    "verify:a11y-probes": "node scripts/verify-accessibility-probes.cjs",
    "verify:subjects": "python3 scripts/verify-subjects.py",
    "verify:accountability": "python3 scripts/verify-accountability.py",
    "verify:vocabulary": "python3 scripts/verify-vocabulary.py",
    "verify:normalization": "python3 scripts/generate-normalization.py --check && python3 scripts/verify-normalization.py",
    "verify:axe-gate": "node scripts/verify-axe-gate.cjs",
    "verify:controls": "python3 scripts/verify-project-controls.py",
    "verify:measurements": "python3 scripts/verify-measurements.py",
    "verify:provenance": "python3 scripts/verify-dataset-provenance.py",
    "verify:verdicts": "python3 scripts/verify-verdict-boundaries.py",
    "verify:hash-disclosure": "python3 scripts/verify-hash-disclosure.py",
    "verify:reserved-subjects": "python3 scripts/verify-reserved-subjects.py",
    "verify:consumer": "node scripts/verify-extension-consumer.cjs",
    "verify:dependencies": "python3 scripts/verify-dependencies.py",
    "check:assertion": "python3 scripts/check-assertion.py",
    "verify:extension-privacy": "node scripts/verify-extension-privacy.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "axe-core": "4.10.3"
  }
}
