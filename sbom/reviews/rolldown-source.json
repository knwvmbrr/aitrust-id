          "./parallelPlugin": "./dist/parallel-plugin.mjs",
          "./parseAst": "./dist/parse-ast-index.mjs",
          "./package.json": "./package.json",
          "./plugins": "./dist/plugins-index.mjs",
          "./utils": "./dist/utils-index.mjs"
        },
